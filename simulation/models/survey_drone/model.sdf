<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="survey_drone">
    <static>true</static>
    <pose>0 0 0.1 0 0 0</pose>

    <!-- Main Chassis Link -->
    <link name="base_link">
      <inertial>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.025</iyy>
          <iyz>0</iyz>
          <izz>0.045</izz>
        </inertia>
      </inertial>

      <!-- Central Avionics Pod -->
      <visual name="body_visual">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><box><size>0.22 0.22 0.08</size></box></geometry>
        <material>
          <ambient>0.15 0.16 0.18 1</ambient>
          <diffuse>0.2 0.22 0.25 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>

      <!-- Top GPS / Telemetry Dome -->
      <visual name="gps_dome">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.15 0.8 0.25 1</diffuse></material>
      </visual>

      <!-- Front Heading Indicator (Vibrant Cyan/Green) -->
      <visual name="heading_indicator">
        <pose>0.12 0 0.04 0 0 0</pose>
        <geometry><box><size>0.03 0.08 0.03</size></box></geometry>
        <material><ambient>0.0 0.8 0.9 1</ambient><diffuse>0.0 0.95 1.0 1</diffuse></material>
      </visual>

      <!-- 4 Quadcopter Arms (Diagonal X-Configuration) -->
      <visual name="arm_front_right">
        <pose>0.14 -0.14 0.03 0 0 -0.785</pose>
        <geometry><box><size>0.28 0.025 0.015</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="arm_front_left">
        <pose>0.14 0.14 0.03 0 0 0.785</pose>
        <geometry><box><size>0.28 0.025 0.015</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="arm_back_right">
        <pose>-0.14 -0.14 0.03 0 0 0.785</pose>
        <geometry><box><size>0.28 0.025 0.015</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="arm_back_left">
        <pose>-0.14 0.14 0.03 0 0 -0.785</pose>
        <geometry><box><size>0.28 0.025 0.015</size></box></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>

      <!-- 4 Motors -->
      <visual name="motor_fr"><pose>0.24 -0.24 0.05 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.035</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse></material></visual>
      <visual name="motor_fl"><pose>0.24 0.24 0.05 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.035</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse></material></visual>
      <visual name="motor_br"><pose>-0.24 -0.24 0.05 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.035</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>
      <visual name="motor_bl"><pose>-0.24 0.24 0.05 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.035</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual>

      <!-- 4 Rotor Blades -->
      <visual name="rotor_fr"><pose>0.24 -0.24 0.07 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry><material><ambient>0.9 0.9 0.95 0.4</ambient><diffuse>0.9 0.9 0.95 0.4</diffuse></material></visual>
      <visual name="rotor_fl"><pose>0.24 0.24 0.07 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry><material><ambient>0.9 0.9 0.95 0.4</ambient><diffuse>0.9 0.9 0.95 0.4</diffuse></material></visual>
      <visual name="rotor_br"><pose>-0.24 -0.24 0.07 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry><material><ambient>0.9 0.9 0.95 0.4</ambient><diffuse>0.9 0.9 0.95 0.4</diffuse></material></visual>
      <visual name="rotor_bl"><pose>-0.24 0.24 0.07 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry><material><ambient>0.9 0.9 0.95 0.4</ambient><diffuse>0.9 0.9 0.95 0.4</diffuse></material></visual>

      <!-- Carbon Landing Skids -->
      <visual name="skid_left"><pose>0 0.12 -0.06 0 0 0</pose><geometry><box><size>0.32 0.015 0.12</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <visual name="skid_right"><pose>0 -0.12 -0.06 0 0 0</pose><geometry><box><size>0.32 0.015 0.12</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

      <!-- Downward Survey Gimbal Camera (Pitch = -60 deg, FOV = 78 deg) -->
      <visual name="gimbal_mount">
        <pose>0.08 0 -0.02 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.03</size></box></geometry>
        <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.08 0 -0.04 0 1.047 0</pose> <!-- 1.047 rad = 60 deg pitch down -->
        <geometry><cylinder><radius>0.018</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
      </visual>

      <!-- Collision Shape -->
      <collision name="base_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.6 0.6 0.25</size></box></geometry>
      </collision>

      <!-- ========================================== -->
      <!-- 1080p RGB Survey Camera Sensor             -->
      <!-- ========================================== -->
      <sensor name="survey_camera" type="camera">
        <pose>0.08 0 -0.04 0 1.047 0</pose>
        <camera>
          <horizontal_fov>1.36136</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/kissanvikas/drone/camera/image_raw</topic>
      </sensor>
    </link>

    <!-- Velocity Control Plugin -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/kissanvikas/drone/cmd_vel</topic>
      <odom_topic>/kissanvikas/drone/odometry</odom_topic>
    </plugin>

    <!-- Odometry Publisher Plugin -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>survey_drone/base_link</robot_base_frame>
      <odom_topic>/kissanvikas/drone/odometry</odom_topic>
      <tf_topic>/kissanvikas/drone/tf</tf_topic>
      <update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>
