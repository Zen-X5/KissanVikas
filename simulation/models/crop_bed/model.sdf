<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="crop_bed">
    <static>true</static>

    <link name="bed_structure">
      <pose>0 0 0.125 0 0 0</pose>

      <!-- Soil Substrate Surface -->
      <visual name="soil_surface">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>11.4 1.1 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.12 0.08 1</ambient>
          <diffuse>0.24 0.16 0.11 1</diffuse>
          <roughness>0.95</roughness>
        </material>
      </visual>

      <!-- Black Agricultural Mulch Film / Drip Line Strip -->
      <visual name="mulch_cover">
        <pose>0 0 0.131 0 0 0</pose>
        <geometry>
          <box>
            <size>11.3 0.95 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <roughness>0.4</roughness>
        </material>
      </visual>

      <!-- Bed Retention Borders (Side + End Planks) -->
      <visual name="border_left">
        <pose>0 -0.58 0 0 0 0</pose>
        <geometry><box><size>11.5 0.06 0.25</size></box></geometry>
        <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse><roughness>0.6</roughness></material>
      </visual>
      <visual name="border_right">
        <pose>0 0.58 0 0 0 0</pose>
        <geometry><box><size>11.5 0.06 0.25</size></box></geometry>
        <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse><roughness>0.6</roughness></material>
      </visual>
      <visual name="border_end_front">
        <pose>-5.72 0 0 0 0 0</pose>
        <geometry><box><size>0.06 1.22 0.25</size></box></geometry>
        <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse><roughness>0.6</roughness></material>
      </visual>
      <visual name="border_end_back">
        <pose>5.72 0 0 0 0 0</pose>
        <geometry><box><size>0.06 1.22 0.25</size></box></geometry>
        <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse><roughness>0.6</roughness></material>
      </visual>

      <!-- Collision for drone/robot interactions -->
      <collision name="bed_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>11.5 1.2 0.25</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
