<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tomato_plant">
    <static>true</static>

    <link name="plant_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Central Support Bamboo Stake -->
      <visual name="bamboo_stake">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry>
        <material>
          <ambient>0.65 0.55 0.4 1</ambient>
          <diffuse>0.75 0.65 0.48 1</diffuse>
        </material>
      </visual>

      <!-- =================================================== -->
      <!-- PHOTOREALISTIC TEXTURED CROSS-BILLBOARDS (3-Way Star)-->
      <!-- =================================================== -->
      <!-- Plane 1: 0 degrees -->
      <visual name="foliage_plane_0deg">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <box><size>0.95 0.005 1.7</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tomato_plant/materials/textures/tomato_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 2: 60 degrees -->
      <visual name="foliage_plane_60deg">
        <pose>0 0 0.85 0 0 1.047</pose>
        <geometry>
          <box><size>0.95 0.005 1.7</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tomato_plant/materials/textures/tomato_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 3: 120 degrees -->
      <visual name="foliage_plane_120deg">
        <pose>0 0 0.85 0 0 2.094</pose>
        <geometry>
          <box><size>0.95 0.005 1.7</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tomato_plant/materials/textures/tomato_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Top-Down Angled Canopy Quads (Optimized for Drone Aerial Camera) -->
      <visual name="aerial_canopy_quad_1">
        <pose>0.1 0.1 1.45 0.45 0.35 0.8</pose>
        <geometry><box><size>0.65 0.65 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tomato_plant/materials/textures/tomato_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aerial_canopy_quad_2">
        <pose>-0.1 -0.1 1.4 -0.45 -0.35 -1.2</pose>
        <geometry><box><size>0.65 0.65 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tomato_plant/materials/textures/tomato_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision Volume -->
      <collision name="plant_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>1.7</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
