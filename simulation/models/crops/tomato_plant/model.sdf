<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tomato_plant">
    <static>true</static>

    <link name="plant_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Vertical Bamboo Support Stake & Trellis Twine -->
      <visual name="trellis_stake">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.7 0.6 0.45 1</ambient><diffuse>0.8 0.68 0.5 1</diffuse></material>
      </visual>

      <!-- Main Vine Stems -->
      <visual name="main_stem">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>1.6</length></cylinder></geometry>
        <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.28 0.6 0.28 1</diffuse></material>
      </visual>

      <!-- Foliage Canopy Layers (Tier 1: Lower - Spreading) -->
      <visual name="foliage_lower">
        <pose>0 0 0.5 0 0 0.78</pose>
        <geometry><box><size>0.65 0.65 0.35</size></box></geometry>
        <material><ambient>0.15 0.48 0.15 1</ambient><diffuse>0.22 0.58 0.22 1</diffuse><roughness>0.8</roughness></material>
      </visual>

      <!-- Foliage Canopy Layers (Tier 2: Mid-canopy) -->
      <visual name="foliage_mid">
        <pose>0 0 0.95 0 0 0.35</pose>
        <geometry><box><size>0.68 0.68 0.4</size></box></geometry>
        <material><ambient>0.18 0.52 0.18 1</ambient><diffuse>0.26 0.65 0.26 1</diffuse><roughness>0.8</roughness></material>
      </visual>

      <!-- Foliage Canopy Layers (Tier 3: Upper Canopy) -->
      <visual name="foliage_upper">
        <pose>0 0 1.4 0 0 1.1</pose>
        <geometry><box><size>0.55 0.55 0.35</size></box></geometry>
        <material><ambient>0.2 0.58 0.2 1</ambient><diffuse>0.3 0.72 0.3 1</diffuse><roughness>0.8</roughness></material>
      </visual>

      <!-- Prominent Ripe Red Tomato Clusters (Visible from Top & Sides for Drone Survey) -->
      <!-- Top/Upper Clusters -->
      <visual name="fruit_top_1">
        <pose>0.18 0.15 1.35 0 0 0</pose>
        <geometry><sphere><radius>0.075</radius></sphere></geometry>
        <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.98 0.12 0.12 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="fruit_top_2">
        <pose>-0.16 -0.14 1.3 0 0 0</pose>
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.98 0.12 0.12 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>

      <!-- Mid-tier Clusters -->
      <visual name="fruit_mid_1">
        <pose>0.26 -0.15 0.95 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.98 0.1 0.1 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="fruit_mid_2">
        <pose>-0.24 0.18 0.9 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.98 0.1 0.1 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>

      <!-- Lower Clusters -->
      <visual name="fruit_low_1">
        <pose>0.24 0.22 0.55 0 0 0</pose>
        <geometry><sphere><radius>0.085</radius></sphere></geometry>
        <material><ambient>0.88 0.06 0.06 1</ambient><diffuse>0.98 0.1 0.1 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="fruit_low_2">
        <pose>-0.22 -0.22 0.58 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.88 0.06 0.06 1</ambient><diffuse>0.98 0.1 0.1 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>

      <!-- Yellow Tomato Blossom Flowers -->
      <visual name="blossom_1">
        <pose>0.08 0.25 1.45 0 0 0</pose>
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><ambient>0.95 0.9 0.1 1</ambient><diffuse>1.0 0.95 0.15 1</diffuse></material>
      </visual>
      <visual name="blossom_2">
        <pose>-0.12 0.22 1.42 0 0 0</pose>
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><ambient>0.95 0.9 0.1 1</ambient><diffuse>1.0 0.95 0.15 1</diffuse></material>
      </visual>

      <collision name="plant_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.35</radius><length>1.7</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
