<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="eggplant_plant">
    <static>true</static>

    <link name="plant_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Central Support Stake -->
      <visual name="support_stake">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>1.0</length></cylinder></geometry>
        <material>
          <ambient>0.58 0.5 0.36 1</ambient>
          <diffuse>0.7 0.6 0.44 1</diffuse>
        </material>
      </visual>

      <!-- =================================================== -->
      <!-- PHOTOREALISTIC TEXTURED CROSS-BILLBOARDS (3-Way Star)-->
      <!-- =================================================== -->
      <!-- Plane 1: 0 degrees -->
      <visual name="foliage_plane_0deg">
        <pose>0 0 0.52 0 0 0</pose>
        <geometry>
          <box><size>0.92 0.005 1.05</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://eggplant_plant/materials/textures/eggplant_real.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 2: 60 degrees -->
      <visual name="foliage_plane_60deg">
        <pose>0 0 0.52 0 0 1.047</pose>
        <geometry>
          <box><size>0.92 0.005 1.05</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://eggplant_plant/materials/textures/eggplant_real.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 3: 120 degrees -->
      <visual name="foliage_plane_120deg">
        <pose>0 0 0.52 0 0 2.094</pose>
        <geometry>
          <box><size>0.92 0.005 1.05</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://eggplant_plant/materials/textures/eggplant_real.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Top-Down Angled Canopy Quads (Optimized for Drone Aerial Camera) -->
      <visual name="aerial_canopy_quad_1">
        <pose>0.08 0.08 0.82 0.4 0.3 0.6</pose>
        <geometry><box><size>0.62 0.62 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://eggplant_plant/materials/textures/eggplant_real.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aerial_canopy_quad_2">
        <pose>-0.08 -0.08 0.8 -0.4 -0.3 -1.1</pose>
        <geometry><box><size>0.62 0.62 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://eggplant_plant/materials/textures/eggplant_real.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision Volume -->
      <collision name="plant_collision">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.42</radius><length>1.1</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
