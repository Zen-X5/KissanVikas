<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="cucumber_plant">
    <static>true</static>

    <link name="plant_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- A-Frame Trellis Frame / Wire Netting -->
      <visual name="trellis_wire_left">
        <pose>0 -0.2 0.75 0.15 0 0</pose>
        <geometry><box><size>0.02 0.02 1.55</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
      <visual name="trellis_wire_right">
        <pose>0 0.2 0.75 -0.15 0 0</pose>
        <geometry><box><size>0.02 0.02 1.55</size></box></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>

      <!-- Climbing Vine Stems -->
      <visual name="climbing_stem">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.22 0.5 0.2 1</ambient><diffuse>0.3 0.62 0.25 1</diffuse></material>
      </visual>

      <!-- Broad Lobed Palmate Leaves (Light Lime/Golden Green) -->
      <visual name="leaves_lower">
        <pose>0 0 0.45 0 0 0.5</pose>
        <geometry><box><size>0.72 0.72 0.3</size></box></geometry>
        <material><ambient>0.2 0.55 0.15 1</ambient><diffuse>0.28 0.7 0.22 1</diffuse><roughness>0.75</roughness></material>
      </visual>

      <visual name="leaves_mid">
        <pose>0 0 0.88 0 0 1.1</pose>
        <geometry><box><size>0.65 0.65 0.35</size></box></geometry>
        <material><ambient>0.22 0.58 0.18 1</ambient><diffuse>0.32 0.75 0.25 1</diffuse><roughness>0.75</roughness></material>
      </visual>

      <visual name="leaves_upper">
        <pose>0 0 1.3 0 0 0.2</pose>
        <geometry><box><size>0.55 0.55 0.3</size></box></geometry>
        <material><ambient>0.25 0.62 0.2 1</ambient><diffuse>0.35 0.8 0.28 1</diffuse><roughness>0.75</roughness></material>
      </visual>

      <!-- Prominent Bright Yellow Cucumber Blooms (Highly Identifiable from Above) -->
      <visual name="yellow_bloom_top_1">
        <pose>0.18 0.15 1.35 0 0 0</pose>
        <geometry><sphere><radius>0.065</radius></sphere></geometry>
        <material><ambient>0.98 0.9 0.05 1</ambient><diffuse>1.0 0.95 0.1 1</diffuse><specular>0.8 0.8 0.2 1</specular></material>
      </visual>
      <visual name="yellow_bloom_top_2">
        <pose>-0.16 -0.14 1.32 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.98 0.9 0.05 1</ambient><diffuse>1.0 0.95 0.1 1</diffuse><specular>0.8 0.8 0.2 1</specular></material>
      </visual>
      <visual name="yellow_bloom_mid">
        <pose>0.22 -0.16 0.95 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material><ambient>0.98 0.9 0.05 1</ambient><diffuse>1.0 0.95 0.1 1</diffuse></material>
      </visual>

      <!-- Large Hanging Dark Green Cucumbers -->
      <visual name="cucumber_fruit_1">
        <pose>0.2 0.12 0.65 0 0 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.32</length></cylinder></geometry>
        <material><ambient>0.05 0.28 0.05 1</ambient><diffuse>0.08 0.38 0.08 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="cucumber_fruit_2">
        <pose>-0.19 -0.14 0.72 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.05 0.28 0.05 1</ambient><diffuse>0.08 0.38 0.08 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="cucumber_fruit_3">
        <pose>0.16 -0.18 1.02 0 0 0</pose>
        <geometry><cylinder><radius>0.034</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.05 0.28 0.05 1</ambient><diffuse>0.08 0.38 0.08 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>

      <collision name="plant_collision">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.38</radius><length>1.6</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
