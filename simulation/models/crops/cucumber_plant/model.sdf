<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="cucumber_plant">
    <static>true</static>

    <link name="plant_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Vertical Trellis Poles -->
      <visual name="trellis_pole_left">
        <pose>0 -0.22 0.8 0.1 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>1.65</length></cylinder></geometry>
        <material>
          <ambient>0.65 0.65 0.65 1</ambient>
          <diffuse>0.78 0.78 0.78 1</diffuse>
        </material>
      </visual>
      <visual name="trellis_pole_right">
        <pose>0 0.22 0.8 -0.1 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>1.65</length></cylinder></geometry>
        <material>
          <ambient>0.65 0.65 0.65 1</ambient>
          <diffuse>0.78 0.78 0.78 1</diffuse>
        </material>
      </visual>

      <!-- =================================================== -->
      <!-- PHOTOREALISTIC TEXTURED CROSS-BILLBOARDS (3-Way Star)-->
      <!-- =================================================== -->
      <!-- Plane 1: 0 degrees -->
      <visual name="foliage_plane_0deg">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <box><size>0.95 0.005 1.6</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cucumber_plant/materials/textures/cucumber_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 2: 60 degrees -->
      <visual name="foliage_plane_60deg">
        <pose>0 0 0.8 0 0 1.047</pose>
        <geometry>
          <box><size>0.95 0.005 1.6</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cucumber_plant/materials/textures/cucumber_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Plane 3: 120 degrees -->
      <visual name="foliage_plane_120deg">
        <pose>0 0 0.8 0 0 2.094</pose>
        <geometry>
          <box><size>0.95 0.005 1.6</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cucumber_plant/materials/textures/cucumber_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Top-Down Angled Canopy Quads (Optimized for Drone Aerial Camera) -->
      <visual name="aerial_canopy_quad_1">
        <pose>0.1 0.1 1.35 0.45 0.35 0.7</pose>
        <geometry><box><size>0.65 0.65 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cucumber_plant/materials/textures/cucumber_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aerial_canopy_quad_2">
        <pose>-0.1 -0.1 1.3 -0.45 -0.35 -1.3</pose>
        <geometry><box><size>0.65 0.65 0.005</size></box></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cucumber_plant/materials/textures/cucumber_real.png</albedo_map>
              <roughness>0.6</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision Volume -->
      <collision name="plant_collision">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.38</radius><length>1.6</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
