        <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.35 0.4 0.45 1</diffuse></material>
      </visual>

      <!-- Collision for main perimeter and columns -->
      <collision name="perimeter_collision_north">
        <pose>0 15.0 2.1 0 0 0</pose>
        <geometry><box><size>60.0 0.2 4.2</size></box></geometry>
      </collision>
      <collision name="perimeter_collision_south">
        <pose>0 -15.0 2.1 0 0 0</pose>
        <geometry><box><size>60.0 0.2 4.2</size></box></geometry>
      </collision>
      <collision name="perimeter_collision_east">
        <pose>30.0 0 2.1 0 0 0</pose>
        <geometry><box><size>0.2 30.0 4.2</size></box></geometry>
      </collision>
      <collision name="perimeter_collision_west">
        <pose>-30.0 0 2.1 0 0 0</pose>
        <geometry><box><size>0.2 30.0 4.2</size></box></geometry>
      </collision>
    </link>

    <!-- Sub-links for the 11 Structural Frame Trusses along X -->
    <!-- Stations at X = -30, -24, -18, -12, -6, 0, 6, 12, 18, 24, 30 -->
    <!-- Each station includes 4 vertical columns and 6 gable rafters (3 bays) -->
    <!-- Rafter angle: atan2(2.3m, 5.0m) = 0.431 rad (24.7 deg), length = sqrt(5^2 + 2.3^2) = 5.50m -->

    <!-- Template for 11 frame stations: -->
    <!-- Bay 1 Rafters: Y=-12.5, Z=5.35, Roll=0.431 & Y=-7.5, Z=5.35, Roll=-0.431 -->
    <!-- Bay 2 Rafters: Y=-2.5, Z=5.35, Roll=0.431 & Y=2.5, Z=5.35, Roll=-0.431 -->
    <!-- Bay 3 Rafters: Y=7.5, Z=5.35, Roll=0.431 & Y=12.5, Z=5.35, Roll=-0.431 -->
    <!-- Horizontal Cross Tie at Z=4.2 across Y from -15 to +15 -->

    <!-- Station 0: X = -30.0 -->
    <link name="frame_st_00">
      <pose>-30.0 0 0 0 0 0</pose>
      <visual name="col_0"><pose>0 -15.0 2.1 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>4.2</length></cylinder></geometry><material><ambient>0.75 0.77 0.8 1</ambient><diffuse>0.82 0.84 0.87 1</diffuse></material></visual>
