      </visual>

      <!-- ========================================== -->
      <!-- Doorway Portal Frames (Front X=-30, Rear X=+30) -->
      <!-- ========================================== -->
      <visual name="door_frame_west">
        <pose>-30.0 0 1.6 0 0 0</pose>
        <geometry><box><size>0.15 3.2 3.2</size></box></geometry>
