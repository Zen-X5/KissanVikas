<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="polyhouse_structure">
    <static>true</static>

    <!-- Main Structural Link -->
    <link name="structure_frame">
      <pose>0 0 0 0 0 0</pose>

      <!-- ========================================== -->
      <!-- Concrete Foundation Plinths & Perimeter    -->
      <!-- ========================================== -->
      <visual name="foundation_north">
        <pose>0 15.0 0.1 0 0 0</pose>
        <geometry><box><size>60.4 0.3 0.2</size></box></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse><roughness>0.8</roughness></material>
      </visual>
      <visual name="foundation_south">
        <pose>0 -15.0 0.1 0 0 0</pose>
        <geometry><box><size>60.4 0.3 0.2</size></box></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse><roughness>0.8</roughness></material>
      </visual>
      <visual name="foundation_east">
        <pose>30.0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.3 30.4 0.2</size></box></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse><roughness>0.8</roughness></material>
      </visual>
      <visual name="foundation_west">
        <pose>-30.0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.3 30.4 0.2</size></box></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse><roughness>0.8</roughness></material>
      </visual>

      <!-- ========================================== -->
      <!-- Longitudinal Gutter Beams (Z = 4.2m)       -->
      <!-- ========================================== -->
      <visual name="gutter_beam_y_neg15">
        <pose>0 -15.0 4.2 0 0 0</pose>
        <geometry><box><size>60.0 0.18 0.18</size></box></geometry>
        <material><ambient>0.7 0.73 0.76 1</ambient><diffuse>0.8 0.83 0.86 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="gutter_beam_y_neg5">
        <pose>0 -5.0 4.2 0 0 0</pose>
        <geometry><box><size>60.0 0.18 0.18</size></box></geometry>
        <material><ambient>0.7 0.73 0.76 1</ambient><diffuse>0.8 0.83 0.86 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="gutter_beam_y_pos5">
        <pose>0 5.0 4.2 0 0 0</pose>
        <geometry><box><size>60.0 0.18 0.18</size></box></geometry>
        <material><ambient>0.7 0.73 0.76 1</ambient><diffuse>0.8 0.83 0.86 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
