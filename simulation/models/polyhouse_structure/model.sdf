      <visual name="tie"><pose>0 0 4.2 0 0 0</pose><geometry><box><size>0.1 30.0 0.1</size></box></geometry><material><ambient>0.7 0.73 0.76 1</ambient><diffuse>0.8 0.83 0.86 1</diffuse></material></visual>
      <visual name="r1"><pose>0 -12.5 5.35 0.431 0 0</pose><geometry><box><size>0.08 5.51 0.08</size></box></geometry><material><ambient>0.7 0.73 0.76 1</ambient><diffuse>0.8 0.83 0.86 1</diffuse></material></visual>
