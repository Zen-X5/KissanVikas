<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="polyhouse_world">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene & Lighting -->
    <scene>
      <ambient>0.7 0.73 0.75 1.0</ambient>
      <background>0.7 0.85 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Gazebo Sim GUI 3D Viewport Configuration -->
    <gui fullscreen="0">
      <!-- Full 3D Interactive Scene Plugin -->
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.7 0.73 0.75</ambient_light>
        <background_color>0.7 0.85 0.95</background_color>
        <camera_pose>0 -45 28 0 0.55 1.5708</camera_pose>
      </plugin>

      <!-- Interactive View Control (Orbit, Pan, Zoom) -->
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- World Control (Play, Pause, Step) -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- World Stats (Sim Time, Real Time Factor) -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Entity Tree & Component Inspector -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>15 -20 35 0.5 0.3 -0.8</pose>
      <diffuse>0.92 0.92 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.4 -0.85</direction>
    </light>

    <!-- Secondary Fill Light inside Polyhouse -->
    <light type="directional" name="diffuse_sky">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.4 0.42 0.45 1</diffuse>
      <direction>0 0 -1</direction>
    </light>

    <!-- Ground Plane & Surrounding Terrain -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>150 150</size></plane></geometry>
        </collision>
        <!-- Surrounding Farmland Surface -->
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>150 150</size></plane></geometry>
          <material>
            <ambient>0.32 0.45 0.25 1</ambient>
            <diffuse>0.38 0.52 0.3 1</diffuse>
            <roughness>0.9</roughness>
          </material>
        </visual>
        <!-- Polyhouse Internal Foundation Floor (60m x 30m) -->
        <visual name="polyhouse_floor">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>60.2 30.2 0.01</size></box></geometry>
          <material>
            <ambient>0.28 0.22 0.18 1</ambient>
            <diffuse>0.34 0.27 0.22 1</diffuse>
            <roughness>0.95</roughness>
          </material>
        </visual>
        <!-- Central Longitudinal Concrete Walkway (60m x 3m) -->
        <visual name="main_walkway_longitudinal">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><box><size>60.0 3.0 0.02</size></box></geometry>
          <material>
            <ambient>0.62 0.64 0.65 1</ambient>
            <diffuse>0.72 0.74 0.75 1</diffuse>
            <roughness>0.7</roughness>
          </material>
        </visual>
        <!-- Transverse Cross Walkway (3m x 30m) -->
        <visual name="main_walkway_transverse">
          <pose>0 0 0.016 0 0 0</pose>
          <geometry><box><size>3.0 30.0 0.02</size></box></geometry>
          <material>
            <ambient>0.62 0.64 0.65 1</ambient>
            <diffuse>0.72 0.74 0.75 1</diffuse>
            <roughness>0.7</roughness>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- POLYHOUSE ARCHITECTURAL MODELS             -->
    <!-- ========================================== -->
    <!-- 1. Structural Steel Frame -->
    <include>
      <uri>model://polyhouse_structure</uri>
      <name>polyhouse_main</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 2. Translucent Greenhouse Polyethylene Cladding -->
    <include>
      <uri>model://polyhouse_covering</uri>
      <name>polyhouse_covering_main</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 3. Rooftop Ventilation System -->
    <include>
      <uri>model://rooftop_ventilation</uri>
      <name>polyhouse_ventilation_system</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

